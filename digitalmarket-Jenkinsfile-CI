pipeline {
    agent any

    // ── Nạp .NET SDK đã cấu hình tự động từ Jenkins Global Tools ──
    tools {
        dotnetsdk 'dotnet8'
    }

    environment {
        // ── Tên Docker image ──
        IMAGE_AUTH     = 'digitalmarket-auth'
        IMAGE_BUSINESS = 'digitalmarket-business'

        // ── Tên container ──
        CONTAINER_AUTH     = 'digitalmarket-auth-container'
        CONTAINER_BUSINESS = 'digitalmarket-business-container'

        // ── Đường dẫn Dockerfile từng microservice ──
        DOCKERFILE_AUTH     = 'Presentation/API/Digitalmarket.Controller.Auth/Dockerfile'
        DOCKERFILE_BUSINESS = 'Presentation/API/Digitalmarket.Controller.Business/Dockerfile'

        // ── Port mapping (host:container) ──
        PORT_AUTH     = '8080'
        PORT_BUSINESS = '8081'

        // ── Tag image theo số build của Jenkins ──
        IMAGE_TAG = "${env.BUILD_NUMBER}"

        // ── Thông số GitHub Status Notify ──
        GITHUB_CREDENTIAL_ID = 'token-git-v1'
        GITHUB_ACCOUNT       = 'HoangDucDung'
        GITHUB_REPO          = 'digitalmarket_be_v2'

        // ── Kéo thư viện libicu cần trên Jenkins Host ──
        DOTNET_SYSTEM_GLOBALIZATION_INVARIANT = 'true'
    }

    stages {
        stage('CI: Restore & Build') {
            steps {
                cleanWs() // Xoá sạch workspace cũ
                checkout scm // Kéo code từ SCM (Github/Gitlab) về

                // ✅ Sửa context để khớp hoàn toàn với block post (CI passed/failed)
                githubNotify(
                    status: 'PENDING', 
                    context: "${env.GITHUB_STATUS_CONTEXT ?: 'Jenkins CI/CD'} - CI", 
                    description: 'Đang kiểm tra compile code...',
                    credentialsId: env.GITHUB_CREDENTIAL_ID,
                    account: env.GITHUB_ACCOUNT,
                    repo: env.GITHUB_REPO,
                    sha: env.GIT_COMMIT
                )
                
                echo 'Restoring packages & building...'
                sh 'dotnet restore'
                sh 'dotnet build --no-restore --configuration Release'
            }

            post {
                success {
                    githubNotify(
                        status: 'SUCCESS', 
                        context: "${env.GITHUB_STATUS_CONTEXT ?: 'Jenkins CI/CD'} - CI", 
                        description: 'CI passed!',
                        credentialsId: env.GITHUB_CREDENTIAL_ID,
                        account: env.GITHUB_ACCOUNT,
                        repo: env.GITHUB_REPO,
                        sha: env.GIT_COMMIT
                    )
                }
                failure {
                    script {
                        // Chỉ gửi notify nếu có commit SHA để tránh crash quy trình hậu kỳ
                        if (env.GIT_COMMIT) {
                            githubNotify(
                                status: 'FAILURE', 
                                context: "${env.GITHUB_STATUS_CONTEXT ?: 'Jenkins CI/CD'} - CI", 
                                description: 'CI failed!',
                                credentialsId: env.GITHUB_CREDENTIAL_ID,
                                account: env.GITHUB_ACCOUNT,
                                repo: env.GITHUB_REPO,
                                sha: env.GIT_COMMIT
                            )
                        } else {
                            echo '⚠️ Bỏ qua gửi GitHub Status vì chưa lấy được thông tin commit.'
                        }
                    }
                }
            }
        }
    }
}
